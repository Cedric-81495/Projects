# ═══════════════════════════════════════════════════════════════════════════
# GWOP UNIVERSITY — environment
# Validated by src/lib/env.ts at boot. A missing required value stops the
# process rather than producing a deploy that looks healthy and grants nobody
# access. NEVER commit a filled-in copy of this file.
# ═══════════════════════════════════════════════════════════════════════════

# ── Public ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://gwopuniversity.com

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# ⚠ BYPASSES ROW LEVEL SECURITY. Server only. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_MODE=test

# ── Bunny Stream (course video) ───────────────────────────────────────────
# The library MUST have token authentication enabled, or these tokens are
# decorative and the raw embed URL plays for anyone holding the GUID.
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_TOKEN_SECURITY_KEY=
BUNNY_CDN_HOSTNAME=vz-xxxxxxxx.b-cdn.net
BUNNY_TOKEN_TTL_SECONDS=900

# ── PostHog ───────────────────────────────────────────────────────────────
# HOST points at our own /ingest reverse proxy, keeping analytics first-party.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://gwopuniversity.com/ingest

# ── GoHighLevel (EMBED ONLY) ──────────────────────────────────────────────
# Jake's form embed URL. There is intentionally no GHL API token: we embed his
# form and never receive, store or forward the lead ourselves.
NEXT_PUBLIC_GHL_FORM_URL=
NEXT_PUBLIC_GHL_EMBED_MODE=iframe
NEXT_PUBLIC_BOOKING_URL=

# ── Rate limiting (optional; Postgres fallback if unset) ──────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Bot protection ────────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Jobs ──────────────────────────────────────────────────────────────────
CRON_SECRET=

# ── Storage ───────────────────────────────────────────────────────────────
MODULE_BUCKET=course-materials
SIGNED_URL_TTL_SECONDS=900
