# backend/.env

# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Allowed browser origins, comma-separated (no trailing slash)
CORS_ORIGINS=http://localhost:5173
# Public URL of the frontend (used for GCash return URLs)
FRONTEND_URL=http://localhost:5173
# 1 behind Render/Heroku/Vercel (default in production), 0 when exposed directly
# TRUST_PROXY=1

# Content-Security-Policy starts report-only (logs violations, blocks nothing).
# Set to true once your live site's browser console shows no CSP violations.
# CSP_ENFORCE=true

# ---------- Database ----------
MONGO_URI=connection_link

# ---------- Auth ----------
# At least 32 random characters (the server refuses to start in production otherwise):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=paste_generated_secret_here
# How long logins last (e.g. 1d, 12h)
JWT_EXPIRES_IN=1d
# Google Sign-In: OAuth 2.0 Client ID from console.cloud.google.com (same value as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# ---------- Seeder (npm run seed) ----------
# Only used when NO admin exists yet. If the password is empty, a random one is printed once.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
# Never set this permanently — only for a deliberate one-off seed of a production DB
# ALLOW_PRODUCTION_SEED=true

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=name
CLOUDINARY_API_KEY=api_key
CLOUDINARY_API_SECRET=api_secret

# ---------- PayMongo (GCash) ----------
PAYMONGO_SECRET_KEY=sk_test_xxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxx

# ---------- PayPal (server-side capture) ----------
PAYPAL_CLIENT_ID=same_as_VITE_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=paypal_secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
