# ── H2C API environment ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (backend ONLY — never expose to frontend).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/h2c?retryWrites=true&w=majority

# Comma-separated browser origins allowed to call this API (CORS, credentials on).
CORS_ORIGIN=http://localhost:5173,https://your-frontend.onrender.com

# ── Admin auth ──
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h
ADMIN_EMAIL=admin@h2c.org
# bcrypt hash of the admin password. Generate: npm run hash -- "your-strong-password"
ADMIN_PASSWORD_HASH=$2a$12$replace_with_generated_hash
# Force secure cookies (HTTPS only). Defaults to true in production.
# COOKIE_SECURE=true
