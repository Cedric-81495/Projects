# ---------------------------------------------------------------------------
# Handcuffs 2 Cufflinks API
# Copy to .env. Never commit real values — .env is gitignored.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB connection string (Atlas or self-hosted).
# Use a DIFFERENT database for staging and production.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/h2c?retryWrites=true&w=majority

# Optional. Only needed if you hit `querySrv ECONNREFUSED` on startup, which
# means your DNS resolver refuses the SRV lookup that mongodb+srv:// requires.
# Common on some routers, corporate networks, and VPNs. Applies to this process
# only — no system settings are changed.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# --- Secrets --------------------------------------------------------------
# Generate each with: openssl rand -base64 48
# These must differ from each other and between environments. Rotating
# JWT_REFRESH_SECRET signs every admin out, which is the intended panic button.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- CORS -----------------------------------------------------------------
# Comma-separated origins allowed to send credentialed requests.
# Must list the exact scheme and host of the frontend. No wildcards: the API
# uses cookies, and a wildcard origin with credentials is rejected by browsers
# and would be unsafe anyway.
CORS_ORIGINS=http://localhost:5173

# --- Google OAuth ---------------------------------------------------------
# Created in Google Cloud Console -> APIs & Services -> Credentials ->
# OAuth client ID -> Web application. Add GOOGLE_CALLBACK_URL below to that
# client's "Authorised redirect URIs" exactly as written — Google matches it
# character for character, and a trailing slash is a different URI.
#
# Leave blank to turn Google sign-in off; the password flow is unaffected.
#
# Note: Google sign-in never CREATES a CMS account. It matches an existing one
# by verified email and refuses otherwise. Members are the opposite — a new
# Google identity creates a member account, because membership is open.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
# Where to send the browser after a successful Google sign-in.
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/admin/dashboard
OAUTH_MEMBER_REDIRECT=http://localhost:5173/community
OAUTH_FAILURE_REDIRECT=http://localhost:5173/sign-in

# --- Site -----------------------------------------------------------------
# Public site origin, used for links in emails and audit records.
SITE_URL=http://localhost:5173
# CMS origin. Password reset and email confirmation links point here.
ADMIN_URL=http://localhost:5173/admin

# --- Mail -----------------------------------------------------------------
# Optional. With no key set, the mailer LOGS each message in full (including
# the reset link) at warn level instead of sending it — so local development
# needs no vendor account, and a misconfigured production deploy is loud
# rather than silently dropping every password reset.
#
# Get a key at resend.com. MAIL_FROM must be an address on a domain verified
# with the provider, or delivery is rejected.
RESEND_API_KEY=
MAIL_FROM=Handcuffs 2 Cufflinks <no-reply@handcuffs2cufflinks.com>

# --- Multi-factor authentication ------------------------------------------
# When true, a super administrator who has not finished TOTP enrolment is
# refused at sign-in. Leave false until every super administrator has enrolled
# — switching it on beforehand locks all of them out of the CMS at once, and
# there is no way back in without database access.
REQUIRE_SUPER_ADMIN_MFA=false

# --- Media storage (Cloudinary) -------------------------------------------
# Cloud name is public and appears in every delivery URL; the key and secret
# are not. With all three set, the CMS can upload straight from the browser to
# Cloudinary. Leave them blank and the media library still works by cataloguing
# assets hosted elsewhere.
#
# Found in Cloudinary: Settings -> API Keys, for the product environment you are
# using. Set VITE_CLOUDINARY_CLOUD_NAME on the frontend to the same cloud name.
CLOUDINARY_CLOUD_NAME=sp5o2rmu
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Everything this platform uploads lands under this folder, then by brand.
CLOUDINARY_FOLDER=handcuffs-2-cufflinks

# --- Vercel rebuild -------------------------------------------------------
# Created in Vercel: Settings -> Git -> Deploy Hooks.
# Fired (debounced) when content is published so prerendered social-preview
# metadata refreshes. Safe to leave blank — publishing still works, and content
# is live for visitors immediately via the runtime API fetch.
VERCEL_DEPLOY_HOOK_URL=
DEPLOY_HOOK_DEBOUNCE_MS=180000
