# ---------------------------------------------------------------------------
# Handcuffs 2 Cufflinks — frontend environment
# Copy to .env.local. Never commit real values. Only VITE_* keys reach the
# browser, so nothing secret belongs in this file.
# ---------------------------------------------------------------------------

# Express API (Render in dev/staging)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Google OAuth — public client ID only. The secret stays on the backend.
VITE_GOOGLE_CLIENT_ID=

# Absolute public origin. REQUIRED for correct canonical URLs and social
# preview images — if this is wrong, every share link unfurls with the wrong
# host. Set it per environment; do not leave a localhost value in a deployed
# build.
VITE_SITE_URL=http://localhost:5173
VITE_YOUTUBE_CHANNEL_ID=

# Cloudinary cloud name — public, it appears in every delivery URL. The API key
# and secret stay on the backend and must never appear in a VITE_ variable.
VITE_CLOUDINARY_CLOUD_NAME=sp5o2rmu

# Feature flags — this is how Showcase -> Preorder -> Commerce is switched on.
# One of: showcase | preorder | commerce
VITE_APPAREL_MODE=showcase
VITE_ENABLE_COMMUNITY_SUBMISSIONS=true
VITE_ENABLE_DONATIONS=false

# ---------------------------------------------------------------------------
# Build-time only (not VITE_ prefixed, never reaches the browser)
# ---------------------------------------------------------------------------

# Blocks indexing for this deployment. MUST be true on staging and preview,
# and MUST be unset or false on production. Setting it on production delists
# the live site; leaving it off staging lets Google index unpublished content.
# SEO_NOINDEX=true
