# Base URL for the API. Point at your backend, including the /api suffix.
#   local dev:   http://localhost:4000/api   (or a Vite proxy to /api)
#   production:  https://YOUR-API.onrender.com/api
VITE_API_BASE=http://localhost:4000/api

# Data source switch for CONTENT (stories/podcast/music).
#   false -> local seed content in src/data
#   true  -> read content from VITE_API_BASE (falls back to seed on error)
# Auth/profile/admin always call the API regardless of this flag.
VITE_USE_API=true

# Google OAuth 2.0 Web client ID (same value as the API's GOOGLE_CLIENT_ID).
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
