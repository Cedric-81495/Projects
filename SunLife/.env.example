# Copy this file to .env for local development with `vercel dev`
# (plain `vite dev` does not run the /api serverless function at all —
# see README.md for how to test the consultation form locally).
#
# In Vercel: Project Settings → Environment Variables → add both,
# WITHOUT a VITE_ prefix. A VITE_ prefix would bundle these into the
# public JS and expose them to anyone viewing the site's source.

# Systeme.io public API key (Settings → MCP & API keys in Systeme.io).
# Leave unset to run the consultation form in test mode: submissions
# are validated and logged server-side instead of sent to Systeme.io.
SYSTEME_IO_API_KEY=

# Your real production domain, used to restrict which site is allowed
# to call /api/submit-consultation. Leave unset during local testing.
ALLOWED_ORIGIN=
