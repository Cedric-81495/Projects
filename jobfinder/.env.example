# ---------------------------------------------------------------------------
# Supabase (free tier)
# ---------------------------------------------------------------------------
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Admin + collection
# ---------------------------------------------------------------------------
# Signs admin session cookies, and works as a bearer token for scripts/curl.
ADMIN_TOKEN=generate-a-long-random-string

# The password typed into the /admin sign-in form. Min 12 characters.
# If unset, ADMIN_TOKEN is used as the password instead.
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_PASSWORD=generate-a-password-you-can-type
CRON_SECRET=generate-another-long-random-string

# Sent on every outbound request so site owners can identify and contact you.
CRAWLER_USER_AGENT=JobFinderBot/0.1 (+https://your-deployment.vercel.app/about)

# Optional: comma-separated Greenhouse board tokens to collect
# (the path segment in boards.greenhouse.io/<token>)
GREENHOUSE_BOARDS=
