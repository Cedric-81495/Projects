# The repository root .gitignore has a bare "README.md" pattern, which would
# otherwise ignore every README in this project. Re-include them here.
!README.md
!**/README.md

# Dependencies
node_modules/

# Environment / secrets
.env
.env.*
!.env.example

# Build output
dist/
build/
out/

# TypeScript incremental build artifacts
*.tsbuildinfo
# `tsc -b` emits these next to vite.config.ts; they are build output, not source
client/vite.config.d.ts
client/vite.config.js

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches
.cache/
.vite/
coverage/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
