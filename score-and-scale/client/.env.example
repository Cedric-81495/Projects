# ---------------------------------------------------------------------------
# Frontend environment
#
# Everything with a VITE_ prefix is inlined into the browser bundle at build
# time. Never put a secret here — only values that are safe to make public.
# ---------------------------------------------------------------------------

# The deployed API on Render. For local development against a local server,
# use http://localhost:4000 instead.
VITE_API_URL=https://score-and-scale-api.onrender.com

# Supabase Storage, used for document uploads.
# The anon key is designed to be public and is governed by Row Level Security.
# It cannot write to the documents bucket without a signed upload token that
# only the API can issue.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_STORAGE_BUCKET=enrollment-documents
