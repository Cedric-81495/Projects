# ---------------------------------------------------------------------------
# Frontend environment
#
# Copy to client/.env for local development. On Netlify, set the same keys in
# the site's build environment.
#
# IMPORTANT: every VITE_ value is inlined into the browser bundle at BUILD time,
# not read at runtime. Two consequences:
#   1. Never put a secret here. Only values safe to make public.
#   2. Changing one in Netlify requires a redeploy to take effect.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_STORAGE_BUCKET=documents

# ---------------------------------------------------------------------------
# Required — not in the original specification, but the app cannot reach the
# backend without it.
#
# There is no runtime discovery of the API host: with this unset the client
# falls back to http://localhost:4000, which fails in any deployed build.
#   local       http://localhost:4000
#   production  https://score-and-scale-api.onrender.com
# ---------------------------------------------------------------------------
VITE_API_URL=https://score-and-scale-api.onrender.com

# ---------------------------------------------------------------------------
# Google sign-in needs no frontend variable.
#
# The authorization-code flow runs entirely server-side: the button is a plain
# link to /api/auth/google on the backend, so no Google client id is exposed in
# this bundle and no Google SDK is shipped to the browser.
# ---------------------------------------------------------------------------
