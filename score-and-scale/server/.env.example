# ---------------------------------------------------------------------------
# Backend environment
#
# Copy to server/.env for local development. On Render, set the same keys as
# service environment variables — nothing here is read from a file in production.
# ---------------------------------------------------------------------------

MONGODB_URI=

# Two DIFFERENT long random strings. Reusing one for both would let a refresh
# token be replayed as an access token, so the server refuses to boot if they
# match. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

BT_ENV=sandbox
BT_MERCHANT_ID=
BT_PUBLIC_KEY=
BT_PRIVATE_KEY=

CONTACT_NOTIFY_EMAIL=cedricsusmerano@gmail.com
RESEND_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Browser origin(s) allowed by CORS, and the base for OAuth redirects and email
# links. Accepts a comma-separated list, so one deployment can serve production
# alongside a preview or a local dev server:
#   https://score-and-scale.netlify.app,http://localhost:5173
# The FIRST entry is treated as canonical for redirects.
CLIENT_URL=http://localhost:5173

PORT=4000
NODE_ENV=production

# Google OAuth 2.0 — authorization-code flow.
# GOOGLE_CALLBACK_URL must match an Authorised redirect URI in the Google Cloud
# console exactly, including scheme and path:
#   local       http://localhost:4000/api/auth/google/callback
#   production  https://score-and-scale-api.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Sender for transactional email. Defaults to a noreply address when unset.
MAIL_FROM="Score and Scale <noreply@scoreandscale.com>"

# Set to 'true' to exercise the rate limiters in development, where they are
# skipped by default.
RATE_LIMIT_IN_DEV=false

# ---------------------------------------------------------------------------
# Required vs optional
# ---------------------------------------------------------------------------
# The server refuses to boot without: MONGODB_URI, JWT_SECRET,
# JWT_REFRESH_SECRET. Everything else has a default or is validated lazily on
# first use, so a missing Braintree, Supabase, Resend, or Google credential
# returns 503 INTEGRATION_NOT_CONFIGURED on the routes that need it instead of
# taking the whole API down.
