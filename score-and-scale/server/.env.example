# ---------------------------------------------------------------------------
# Backend environment
#
# Copy to server/.env for local development. On Render, set the same keys as
# service environment variables — nothing here is read from a file in production.
#
# Every value is read exclusively from the environment; no URL, key, or
# credential is hardcoded anywhere in src/. All values are trimmed on read, so a
# trailing space copied from a dashboard cannot break authentication.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Required — the server refuses to boot without these
# ---------------------------------------------------------------------------

# MUST include the database name, BEFORE the query string:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/score-and-scale?retryWrites=true&w=majority
#
# A connection string with no database path makes the driver silently fall back
# to "test". Startup refuses that outright rather than writing production data
# into the wrong database — see MONGODB_DB_NAME below if you cannot change the URI.
MONGODB_URI=

# Two DIFFERENT long random strings. Reusing one for both would let a refresh
# token be replayed as an access token, so the server refuses to boot if they
# match. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---------------------------------------------------------------------------
# Core — has a default, but set explicitly per environment
# ---------------------------------------------------------------------------

# Drives ALL of: the CORS allowlist, cookie security flags, OAuth redirects, and
# post-login frontend redirects. Comma-separated; the FIRST entry is canonical
# and is what redirects and email links are built against.
#   production   https://score-and-scale.netlify.app
#   development  http://localhost:5173
#
# Outside production, http://localhost:5173 and http://127.0.0.1:5173 are added
# to the CORS allowlist automatically, so a single production value still works
# when running the API locally. This never applies when NODE_ENV=production.
CLIENT_URL=http://localhost:5173

# Controls cookie security automatically:
#   production   Secure + SameSite=None  (required: Netlify and Render are
#                different sites, so the session cookie must be cross-site)
#   otherwise    SameSite=Lax, not Secure (required: localhost is plain http)
NODE_ENV=development

PORT=4000

# ---------------------------------------------------------------------------
# Optional integrations
#
# Each is validated lazily on first use, so the API boots and serves every
# unrelated route while these are blank. Routes that need a missing integration
# return 503 INTEGRATION_NOT_CONFIGURED instead of taking the whole API down.
# ---------------------------------------------------------------------------

# Braintree — required by /api/checkout and /api/webhooks/braintree
BT_ENV=sandbox
BT_MERCHANT_ID=
BT_PUBLIC_KEY=
BT_PRIVATE_KEY=

# Supabase Storage — required by /api/documents.
# SERVICE_ROLE bypasses Row Level Security. It is confined to src/lib/storage.ts
# and must never reach the browser bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Resend transactional email
CONTACT_NOTIFY_EMAIL=
RESEND_API_KEY=

# Google OAuth 2.0 — server-side authorization-code flow.
# All three are required together; a partial config reports itself unconfigured
# rather than half-working.
#
# GOOGLE_CALLBACK_URL must match an Authorised redirect URI in the Google Cloud
# console EXACTLY (scheme, host, port, path). Register both:
#   development  http://localhost:4000/api/auth/google/callback
#   production   https://score-and-scale-api.onrender.com/api/auth/google/callback
#
# The server also serves the callback at whatever path this URL specifies, so a
# versioned prefix such as /api/v1/auth/google/callback works without renaming
# any other route.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------

# Explicit database name, taking precedence over the path in MONGODB_URI. Use it
# when one cluster URI serves several environments, or when the URI cannot carry
# a path. Reserved names (test, admin, local, config) are rejected either way.
# MONGODB_DB_NAME=score-and-scale

# Sender for transactional email. Defaults to a noreply address when unset.
# MAIL_FROM="Score and Scale <noreply@scoreandscale.com>"

# Set to 'true' to exercise the rate limiters in development, where they are
# skipped by default.
# RATE_LIMIT_IN_DEV=false
