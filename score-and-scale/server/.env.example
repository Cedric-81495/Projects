# ---------------------------------------------------------------------------
# Core (required — the server refuses to boot without these)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/score-and-scale

# Use two different long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string

# Comma-separated list of browser origins allowed to call this API.
# Production frontend is the Netlify deployment.
CLIENT_ORIGIN=https://score-and-scale.netlify.app,http://localhost:5173

# ---------------------------------------------------------------------------
# Optional integrations. Each is validated lazily on first use, so the API
# boots and serves every unrelated route even when these are unset. Routes
# that need a missing integration return 503 with an explanatory error code.
# ---------------------------------------------------------------------------

# Braintree payments — required by /api/checkout and /api/webhooks/braintree
BT_ENV=sandbox
BT_MERCHANT_ID=
BT_PUBLIC_KEY=
BT_PRIVATE_KEY=

# Supabase Storage — required by /api/documents
# SERVICE_ROLE key is server-only. It bypasses Row Level Security; never ship
# it to the browser bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=enrollment-documents

# Resend transactional email — required by contact notifications
RESEND_API_KEY=
MAIL_FROM="Score and Scale <noreply@scoreandscale.com>"
ADMIN_NOTIFICATION_EMAIL=admin@scoreandscale.com

# Google OAuth — required by POST /api/auth/google
GOOGLE_CLIENT_ID=
